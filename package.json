{
  "name": "wisebiz",
  "version": "1.0.0",
  "description": "WiseBiz - Production-ready Node.js microservices e-commerce platform",
  "private": true,

  "scripts": {
    "start:gateway": "node services/api-gateway/src/index.js",
    "start:auth": "node services/auth-svc/src/index.js",
    "start:user": "node services/user-svc/src/index.js",
    "start:product": "node services/product-svc/src/index.js",
    "start:cart": "node services/cart-svc/src/index.js",
    "start:order": "node services/order-svc/src/index.js",
    "start:payment": "node services/payment-svc/src/index.js",
    "start:notification": "node services/notification-svc/src/index.js",
    "start:frontend": "node services/frontend-svc/src/index.js",
    "dev:gateway": "nodemon services/api-gateway/src/index.js",
    "dev:auth": "nodemon services/auth-svc/src/index.js",
    "dev:user": "nodemon services/user-svc/src/index.js",
    "dev:product": "nodemon services/product-svc/src/index.js",
    "dev:cart": "nodemon services/cart-svc/src/index.js",
    "dev:order": "nodemon services/order-svc/src/index.js",
    "dev:payment": "nodemon services/payment-svc/src/index.js",
    "dev:notification": "nodemon services/notification-svc/src/index.js",
    "dev:frontend": "nodemon services/frontend-svc/src/index.js",
    "migrate": "node scripts/migrate-all.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint services/**/src/**/*.js",
    "format": "prettier --write \"services/**/src/**/*.js\""
  },
  "devDependencies": {
    "eslint": "^9.27.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
