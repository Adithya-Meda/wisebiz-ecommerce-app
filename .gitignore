# ─────────────────────────────────────────────────────────────────────────────
# WiseBiz Ecommerce App — .gitignore
# CRITICAL: This file protects against accidental secret exposure.
# Review every section before pushing to any public repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & Credentials ─────────────────────────────────────────────────────
# NEVER commit these — rotate immediately if pushed accidentally
.env
.env.*
!.env.example        # .env.example is safe to commit (no real values)
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets.*
credentials.*
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
services/*/node_modules/    # explicit per-service safety net
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
.pnp.*
.node_repl_history
*.tgz
.npmrc              # may contain NODE_AUTH_TOKEN — use .npmrc at build time only

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
coverage/
*.lcov
.nyc_output/

# ── Docker ────────────────────────────────────────────────────────────────────
# Local overrides for compose — may contain real creds or ports
compose.override.yml
docker-compose.override.yml
.docker/

# ── Local data volumes (spun up by compose.yml) ───────────────────────────────
# These directories are created by bind-mount if any — never commit data
data/
postgres-data/
mongo-data/
redis-data/
rabbitmq-data/

# ── OS & Editor noise ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*~

# ── Testing & Coverage ────────────────────────────────────────────────────────
.jest-cache/
jest.config.local.*
test-results/
playwright-report/
.playwright/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
pids/
*.pid
*.seed

# ── Temporary ─────────────────────────────────────────────────────────────────
tmp/
temp/
.tmp/

# ── Local learning/dev artifacts — not for public repo ────────────────────────
wisebiz_report.html
