<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title><%= title %></title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🔒</text></svg>"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"/>
<link rel="stylesheet" href="/css/main.css"/>
</head><body>
<%- include('partials/navbar') %>
<main class="main-content">

<div class="section-sm">
  <div class="container-sm">
    <div class="breadcrumb"><a href="/">Home</a><span class="breadcrumb-sep">/</span><a href="/cart">Cart</a><span class="breadcrumb-sep">/</span><span>Checkout</span></div>
    <h1 style="margin-bottom:32px;">Checkout</h1>

    <% if(locals.error){ %><div class="alert alert-danger" style="margin-bottom:24px;">❌ <%= error %></div><%}%>

    <div style="display:grid;grid-template-columns:1fr 340px;gap:32px;align-items:start;">
      <form action="/checkout/place-order" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
        <!-- Saved Addresses -->
        <% if(addresses.length){ %>
        <div class="card card-body" style="margin-bottom:24px;">
          <h3 style="margin-bottom:16px;">Saved Addresses</h3>
          <div style="display:flex;flex-direction:column;gap:12px;">
            <% addresses.forEach((a,i)=>{ %>
            <label style="display:flex;align-items:flex-start;gap:12px;padding:14px;border:1.5px solid var(--border);border-radius:var(--radius-sm);cursor:pointer;transition:border-color .2s;" class="addr-option">
              <input type="radio" name="shipping_address_id" value="<%= a.id %>" style="margin-top:2px;" <%=i===0||a.is_default?'checked':''%> onchange="toggleAddressForm(false)"/>
              <div style="font-size:.875rem;">
                <strong><%= a.full_name %></strong>
                <% if(a.is_default){%> <span style="background:var(--primary);color:#fff;font-size:.65rem;font-weight:700;padding:2px 8px;border-radius:10px;margin-left:4px;">Default</span><%}%>
                <div style="color:var(--muted);margin-top:2px;line-height:1.5;"><%= a.line1 %><% if(a.line2){%>, <%= a.line2 %><%}%><br/><%= a.city %>, <%= a.state %> <%= a.postal_code %></div>
              </div>
            </label>
            <%})%>
            <label style="display:flex;align-items:center;gap:12px;padding:14px;border:1.5px dashed var(--border);border-radius:var(--radius-sm);cursor:pointer;">
              <input type="radio" name="shipping_address_id" value="" onchange="toggleAddressForm(true)"/>
              <span style="font-size:.875rem;color:var(--primary);font-weight:600;">+ Add a new address</span>
            </label>
          </div>
        </div>
        <%}%>

        <!-- New address form -->
        <div class="card card-body" id="newAddressForm" style="margin-bottom:24px; <%=addresses.length?'display:none;':''%>">
          <h3 style="margin-bottom:16px;">Shipping Address</h3>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Full Name *</label><input type="text" name="full_name" class="form-control" required placeholder="Your full name"/></div>
            <div class="form-group"><label class="form-label">Phone</label><input type="text" name="phone" class="form-control" placeholder="+91 98765 43210"/></div>
          </div>
          <div class="form-group"><label class="form-label">Address Line 1 *</label><input type="text" name="line1" class="form-control" required placeholder="Street address, apartment, etc."/></div>
          <div class="form-group"><label class="form-label">Address Line 2</label><input type="text" name="line2" class="form-control" placeholder="Landmark (optional)"/></div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">City *</label><input type="text" name="city" class="form-control" required placeholder="City"/></div>
            <div class="form-group"><label class="form-label">State *</label><input type="text" name="state" class="form-control" required placeholder="State"/></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Postal Code *</label><input type="text" name="postal_code" class="form-control" required placeholder="PIN code"/></div>
            <div class="form-group"><label class="form-label">Country</label><input type="text" name="country" class="form-control" value="India"/></div>
          </div>
        </div>

        <div class="card card-body" style="margin-bottom:24px;">
          <h3 style="margin-bottom:16px;">Order Notes <span style="font-weight:400;font-size:.875rem;color:var(--muted);">(optional)</span></h3>
          <textarea name="notes" class="form-control" rows="3" placeholder="Special instructions for delivery..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-full">Continue to Payment →</button>
      </form>

      <!-- Order Summary -->
      <div class="cart-summary">
        <h3 style="margin-bottom:20px;">Order Summary</h3>
        <% cart.items.forEach(item=>{ %>
        <div class="flex-between" style="padding:8px 0;font-size:.875rem;border-bottom:1px solid var(--border);">
          <span style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= item.name %> × <%= item.quantity %></span>
          <span style="font-weight:600;">₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></span>
        </div>
        <%})%>
        <div class="summary-row" style="margin-top:8px;"><span>Subtotal</span><span>₹<%= cart.subtotal.toLocaleString('en-IN') %></span></div>
        <div class="summary-row"><span>Shipping</span><span style="color:var(--success);"><%=cart.subtotal>=1000?'FREE':'₹79'%></span></div>
        <div class="summary-row"><span>GST (18%)</span><span>₹<%= (cart.subtotal*0.18).toFixed(2) %></span></div>
        <div class="summary-row total"><span>Total</span><span style="color:var(--primary);">₹<%= (cart.subtotal+(cart.subtotal>=1000?0:79)+cart.subtotal*0.18).toFixed(2) %></span></div>
        <div style="margin-top:16px;padding:12px;background:var(--bg);border-radius:var(--radius-sm);font-size:.8rem;color:var(--muted);">
          🔒 Your payment info is encrypted and secure.
        </div>
      </div>
    </div>
  </div>
</div>
</main>
<%- include('partials/footer') %>
<div class="toast-container" id="toastContainer"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="/js/app.js"></script>
<script>
function toggleAddressForm(show) {
  const form = document.getElementById('newAddressForm');
  if(form) { form.style.display = show ? '' : 'none'; gsap.fromTo(form, {opacity:0,y:10},{opacity:1,y:0,duration:.3}); }
}
// Highlight selected address option
document.querySelectorAll('.addr-option').forEach(label => {
  const input = label.querySelector('input');
  if(input) input.addEventListener('change', () => {
    document.querySelectorAll('.addr-option').forEach(l => l.style.borderColor='var(--border)');
    if(input.checked) label.style.borderColor='var(--primary)';
  });
  if(input && input.checked) label.style.borderColor='var(--primary)';
});
</script>
</body></html>
