<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title><%= title %></title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📦</text></svg>"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"/>
<link rel="stylesheet" href="/css/main.css"/>
</head><body>
<%- include('../partials/navbar') %>
<main class="main-content">
<% if(locals.flash){%><div class="container" style="padding-top:16px;"><div class="alert alert-<%=flash.type%>"><%=flash.message%></div></div><%}%>

<div class="section-sm">
  <div class="container">
    <div class="flex-between" style="margin-bottom:32px;flex-wrap:wrap;gap:16px;">
      <h1>My Orders</h1>
      <form method="GET" style="display:flex;gap:8px;">
        <select name="status" class="form-control" style="width:auto;" onchange="this.form.submit()">
          <option value="">All Orders</option>
          <option value="pending"   <%=query.status==='pending'   ?'selected':''%>>Pending</option>
          <option value="confirmed" <%=query.status==='confirmed' ?'selected':''%>>Confirmed</option>
          <option value="shipped"   <%=query.status==='shipped'   ?'selected':''%>>Shipped</option>
          <option value="delivered" <%=query.status==='delivered' ?'selected':''%>>Delivered</option>
          <option value="cancelled" <%=query.status==='cancelled' ?'selected':''%>>Cancelled</option>
        </select>
      </form>
    </div>

    <% if(!orders.length){ %>
    <div style="text-align:center;padding:80px;background:var(--white);border-radius:var(--radius);box-shadow:var(--card-shadow);">
      <div style="font-size:4rem;margin-bottom:16px;">📦</div>
      <h2 style="margin-bottom:8px;">No orders yet</h2>
      <p style="color:var(--muted);margin-bottom:28px;">Once you place an order, it will appear here.</p>
      <a href="/products" class="btn btn-primary btn-lg">Start Shopping</a>
    </div>
    <% } else { %>
    <div style="display:flex;flex-direction:column;gap:16px;">
      <% orders.forEach(o=>{ %>
      <div class="card order-row" style="transition:var(--transition);">
        <div class="card-body">
          <div class="flex-between" style="flex-wrap:wrap;gap:12px;margin-bottom:16px;">
            <div>
              <div style="font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;">Order Number</div>
              <a href="/orders/<%= o.id %>" style="font-size:1rem;font-weight:700;color:var(--primary);font-family:monospace;"><%= o.order_number %></a>
            </div>
            <span class="status-badge status-<%= o.status %>">
              <% const icons={pending:'⏳',confirmed:'✅',processing:'⚙️',shipped:'🚚',delivered:'🏠',cancelled:'❌',refunded:'💰'}; %>
              <%= icons[o.status] || '•' %> <%= o.status.charAt(0).toUpperCase()+o.status.slice(1) %>
            </span>
          </div>

          <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap;">
            <% (o.items || []).slice(0,3).forEach(item=>{ %>
            <img src="<%= item.product_image || 'https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?w=80' %>" alt="" style="width:52px;height:52px;border-radius:var(--radius-sm);object-fit:cover;border:1px solid var(--border);"/>
            <%})%>
            <% if((o.items||[]).length > 3){ %><span style="font-size:.8rem;color:var(--muted);">+<%= o.items.length-3 %> more</span><%}%>
          </div>

          <div class="flex-between" style="flex-wrap:wrap;gap:8px;">
            <div style="font-size:.85rem;color:var(--muted);">
              <%= (o.items||[]).length %> item<%= (o.items||[]).length!==1?'s':'' %> ·
              <%= new Date(o.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
            </div>
            <div style="display:flex;align-items:center;gap:16px;">
              <span style="font-size:1.1rem;font-weight:700;color:var(--dark);">₹<%= parseFloat(o.total_amount).toLocaleString('en-IN') %></span>
              <a href="/orders/<%= o.id %>" class="btn btn-outline btn-sm">View Details →</a>
            </div>
          </div>
        </div>
      </div>
      <%})%>
    </div>

    <% if(pagination.totalPages > 1){ %>
    <div style="display:flex;justify-content:center;margin-top:32px;">
      <div class="pagination">
        <% for(let i=1;i<=pagination.totalPages;i++){ %>
        <a href="?page=<%=i%><%=query.status?'&status='+query.status:''%>" class="page-btn <%=i===pagination.page?'active':''%>"><%=i%></a>
        <%}%>
      </div>
    </div>
    <%}%>
    <%}%>
  </div>
</div>
</main>
<%- include('../partials/footer') %>
<div class="toast-container" id="toastContainer"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="/js/app.js"></script>
<script>gsap.from('.order-row',{opacity:0,y:24,stagger:.08,duration:.5,ease:'power3.out'});</script>
</body></html>
