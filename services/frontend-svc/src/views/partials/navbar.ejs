<nav class="navbar" id="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-brand">🛍 WiseBiz</a>

    <nav class="navbar-nav">
      <a href="/" class="nav-link">Home</a>
      <a href="/products" class="nav-link">Shop</a>
      <a href="/products?category=electronics" class="nav-link">Electronics</a>
      <a href="/products?category=fashion" class="nav-link">Fashion</a>
    </nav>

    <!-- Search bar -->
    <form action="/products" method="GET" style="flex:1;max-width:340px;margin:0 24px;">
      <div style="position:relative;">
        <input
          type="text"
          name="search"
          placeholder="Search products..."
          value="<%= locals.query?.search || '' %>"
          style="width:100%;padding:9px 16px 9px 40px;border-radius:24px;border:1.5px solid var(--border);font-size:.875rem;background:var(--bg);outline:none;transition:var(--transition);"
          onfocus="this.style.borderColor='var(--primary)'"
          onblur="this.style.borderColor='var(--border)'"
        />
        <span style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted);">🔍</span>
      </div>
    </form>

    <div class="navbar-actions">
      <% if (locals.user) { %>
        <a href="/cart" class="btn btn-outline btn-sm cart-icon">
          🛒
          <% if (locals.cartCount > 0) { %>
            <span class="cart-badge"><%= cartCount %></span>
          <% } %>
        </a>
        <div style="position:relative;" id="accountDropdown">
          <button
            class="btn btn-outline btn-sm"
            onclick="document.getElementById('dropdownMenu').classList.toggle('open')"
            style="gap:6px;"
          >
            👤 <%= user.first_name %>
          </button>
          <div id="dropdownMenu" style="display:none;position:absolute;right:0;top:calc(100% + 8px);background:var(--white);border:1px solid var(--border);border-radius:var(--radius-sm);box-shadow:0 8px 32px rgba(0,0,0,.12);min-width:180px;z-index:100;overflow:hidden;">
            <a href="/account" style="display:block;padding:12px 16px;font-size:.875rem;transition:background .15s;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">👤 My Account</a>
            <a href="/orders"  style="display:block;padding:12px 16px;font-size:.875rem;transition:background .15s;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">📦 My Orders</a>
            <hr style="border:none;border-top:1px solid var(--border);" />
            <form action="/auth/logout" method="POST" style="margin:0;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
              <button type="submit" style="display:block;width:100%;padding:12px 16px;font-size:.875rem;text-align:left;background:none;border:none;cursor:pointer;color:var(--danger);">🚪 Sign Out</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a href="/auth/login"    class="btn btn-outline btn-sm">Sign In</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Get Started</a>
      <% } %>
    </div>
  </div>
</nav>
<script>
  document.addEventListener('click', function(e) {
    const dd = document.getElementById('accountDropdown');
    const menu = document.getElementById('dropdownMenu');
    if (dd && menu && !dd.contains(e.target)) { menu.style.display = 'none'; }
  });
  document.getElementById('dropdownMenu') && document.querySelectorAll('[onclick]').forEach(el => {
    el.addEventListener('click', function() {
      const m = document.getElementById('dropdownMenu');
      if (m) m.style.display = m.style.display === 'none' ? 'block' : 'none';
    });
  });
</script>
